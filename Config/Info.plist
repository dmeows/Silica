<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist. Lets Finder's Open With, the Dock
	     icon and `open -a Silica` hand files and folders to Silica. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Text</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.text</string>
				<string>public.data</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>

	<!-- Sparkle updates. The feed is docs/appcast.xml served by GitHub Pages; changing
	     this URL after a release strands the users of that release on it. -->
	<key>SUFeedURL</key>
	<string>https://dqhieu.github.io/Silica/appcast.xml</string>
	<!-- Public half of the EdDSA key in the release machine's Keychain
	     (Sparkle's generate_keys, account "ed25519"). Updates must be signed with it. -->
	<key>SUPublicEDKey</key>
	<string>T9aDbtANF0yr9ZMLWC98FVvzQiAmkIPy/JggQKIEvl0=</string>
	<!-- Check daily without first asking; Settings › General turns it off. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
